{
  "name": "vigil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "tsc -b && cf deploy",
    "deploy:dry-run": "tsc -b && cf deploy --dry-run",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:a11y:live": "A11Y_BASE_URL=https://vigil.georgesuarezdev.workers.dev playwright test",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@arcgis/core": "^5.1.27",
    "@arcgis/map-components": "5.1.27",
    "@esri/calcite-components": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "1.0.0-beta.20",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.88.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@12.14.0"
}
