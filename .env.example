# Optional — ArcGIS Location Platform API key.
# Create a free developer key at https://locationplatform.arcgis.com/
#
# What it enables when set:
#   - Esri vector basemaps and basemap styles
#   - The Search widget (geocoding)
#   - Any premium Living Atlas content
#
# Without a key the app still runs: it uses the OpenStreetMap basemap and the
# keyless sample services in src/lib/layers.ts.
VITE_ARCGIS_API_KEY=

# Optional — Anthropic API key for the "Ask the map" panel's LLM mode.
# Without it the panel uses the offline rule-based parser (no network calls).
VITE_ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-haiku-4-5-20251001.
VITE_ANTHROPIC_MODEL=
