# Optional — ArcGIS Location Platform API key.
# Create a free developer key at https://locationplatform.arcgis.com/
#
# What it enables when set:
#   - Esri vector basemaps and basemap styles
#   - The Search widget (geocoding)
#   - Any premium Living Atlas content
#
# Without a key the app still runs: it uses the OpenStreetMap basemap and the
# keyless sample services in src/lib/layers.ts.
VITE_ARCGIS_API_KEY=

# Optional — LLM provider for the "Ask the map" panel.
#
# Without a key the panel uses the offline rule-based parser (no network calls).
# Supported providers and their defaults:
#   anthropic -> https://api.anthropic.com/v1  (claude-haiku-4-5-20251001)
#   openai    -> https://api.openai.com/v1     (gpt-6-luna)
#   opencode  -> https://opencode.ai/zen/v1    (glm-5.3-flash)
#
# Set "openai" plus VITE_LLM_BASE_URL to use any OpenAI-compatible gateway.
# OpenCode Go keys: keep VITE_LLM_PROVIDER=opencode, set
# VITE_LLM_BASE_URL=https://opencode.ai/zen/go/v1, and choose a Go model.
# Vite embeds VITE_* values in the client bundle, so use scoped/demo keys and
# never commit .env.local.
VITE_LLM_PROVIDER=
VITE_LLM_API_KEY=

# Optional model override. Defaults per provider (see above).
VITE_LLM_MODEL=

# Optional base URL override. The app appends /chat/completions for OpenAI-style
# providers (or /messages for Anthropic) when the path is missing.
VITE_LLM_BASE_URL=

# Provider-specific aliases. Setting just one of these selects its provider,
# so VITE_LLM_PROVIDER is optional. VITE_LLM_API_KEY wins when both are set.
# VITE_ANTHROPIC_API_KEY=
# VITE_ANTHROPIC_MODEL=
# VITE_OPENAI_API_KEY=
# VITE_OPENAI_MODEL=
# VITE_OPENCODE_API_KEY=
# VITE_OPENCODE_MODEL=
